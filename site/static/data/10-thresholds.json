":40.069,"e":40.869}]},{"template":"code","chapter":"Thresholds per action","narration":"But one threshold for everything is a mistake. Thresholds belong to actions. In this voice banking example, checking a balance is harmless if it's wrong, so point six is enough. Approving a transfer is not, so it needs point eight five to go through, and anything less gets a spoken confirmation. And below point six, nothing happens without a person.","params":{"file":"voice_banking.py","lang":"py","lines":["intent = answers[\"intent\"]","if intent.confidence < 0.6:","    route_to_support_agent(account)        # genuinely unsure","elif intent.choice == \"check_balance\":","    show_balance(account)                  # low stakes: 0.6 is fine","elif intent.choice == \"approve_transfer\":","    if intent.confidence > 0.85:","        approve_transfer(account)          # high stakes, high confidence","    else:","        ask_user_to_confirm(account)       # high stakes, moderate"],"hl":[{"from":4,"to":5,"label":"cheap mistake","tone":"good","at":"harmless"},{"from":7,"to":10,"label":"expensive mistake","tone":"bad","at":"Approving a transfer"}]},"start":41.477,"dur":24.199,"words":[{"text":"But","s":41.777,"e":42.017},{"text":"one","s":42.097,"e":42.257},{"text":"threshold","s":42.337,"e":42.817},{"text":"for","s":42.937,"e":43.057},{"text":"everything","s":43.217,"e":43.857},{"text":"is","s":43.937,"e":44.017},{"text":"a","s":44.057,"e":44.097},{"text":"mistake.","s":44.257,"e":45.137},{"text":"Thresholds","s":45.217,"e":45.777},{"text":"belong","s":45.857,"e":46.097},{"text":"to","s":46.177,"e":46.337},{"text":"actions.","s":46.697,"e":47.457},{"text":"In","s":47.537,"e":47.617},{"text":"this","s":47.697,"e":47.777},{"text":"voice","s":47.857,"e":48.017},{"text":"banking","s":48.097,"e":48.417},{"text":"example,","s":48.497,"e":49.217},{"text":"checking","s":49.377,"e":49.537},{"text":"a","s":49.617,"e":49.697},{"text":"balance","s":49.897,"e":50.097},{"text":"is","s":50.177,"e":50.